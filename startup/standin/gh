#!/bin/sh
# Stand-in for the code host's tool, for tests. `gh api graphql` answers with the lines
# in $STANDIN_STATE/gh/lines: what the real tool prints once tracker.jq has been applied.
S="${STANDIN_STATE:?}/gh"
{ printf 'gh %s\n' "$*" >> "$STANDIN_STATE/calls.log"; } 2>/dev/null
case "${1:-} ${2:-}" in
  "auth status")
    if [ -f "$S/signed_out" ]; then echo "You are not logged into any GitHub hosts." >&2; exit 1; fi
    echo "github.com"; echo "  Logged in to github.com" ;;
  "api graphql")
    if [ -f "$S/api_fail" ]; then echo "gh: Could not resolve to a Repository" >&2; exit 1; fi
    cat "$S/lines" ;;
  "pr list"|"pr view"|"pr status"|"pr checks"|"issue list"|"issue view"|"issue status")
    [ -f "$S/summary" ] && cat "$S/summary"; exit 0 ;;
  "pr "*|"issue "*) : ;;
  *) echo "stand-in gh: no answer for: $*" >&2; exit 2 ;;
esac
